{
  "name": "mlgrind-lectures",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turns ML Grind lecture scripts into narrated, animated MP4 lectures (Remotion + Deepgram Aura).",
  "scripts": {
    "narrate": "NODE_USE_ENV_PROXY=1 tsx tools/narrate.ts",
    "render": "tsx tools/render.ts",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/instrument-serif": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "yaml": "2.6.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
